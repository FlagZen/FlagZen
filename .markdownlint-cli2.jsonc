{
  "config": {
    // allow long lines
    "MD013": false,
    // allow duplicated headings
    "MD024": false,
    // allow ordered lists starting with any number
    "MD029": false,
    // allow emphasis "as" headline
    "MD036": false,
    // allow code fences without specifying the language (used for plain text)
    "MD040": false,
    // disable table column alignment check (conflicts with inline code in cells)
    "MD060": false
  },
  "gitignore": true,
  "ignores": [
    ".nwave"
  ]
}
